{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "PriceDrop",
  "version": "0.1.0",
  "description": "__MSG_appDesc__",
  "default_locale": "nl",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "i18n.js",
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pricedropalert.app/*"
  ],
  "homepage_url": "https://pricedropalert.app"
}
