# bol.com affiliate: aanvragen via affiliate.bol.com -> API-toegang (client credentials)
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
# Je affiliate site-id (te vinden in je bol affiliate dashboard)
BOL_SITE_ID=
# Supabase (Project settings -> API). Gebruik de service_role key, alleen server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Resend (resend.com) voor e-mail alerts
RESEND_API_KEY=
EMAIL_FROM="Prijsdaler <alerts@jouwdomein.nl>"
# Publieke basis-URL van de site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Geheim waarmee Vercel Cron de check-route aanroept (Vercel zet dit zelf als Authorization: Bearer)
CRON_SECRET=
