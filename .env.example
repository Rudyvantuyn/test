# ---- Opslag & mail ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM="PriceDrop <alerts@yourdomain.com>"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=

# ---- bol.com (NL/BE) — affiliate.bol.com -> API-toegang ----
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
BOL_SITE_ID=

# ---- Amazon Product Advertising API 5.0 ----
# Eén keypair per Associates-account; EU-landen delen één account (DE/FR/IT/ES/NL/BE/SE/PL/UK/TR/AE/SA/EG/IN), US+CA+MX+BR delen één, JP/AU/SG apart.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=yourtag-21
# Optioneel per land (overschrijft AMAZON_PARTNER_TAG): AMAZON_PARTNER_TAG_DE, AMAZON_PARTNER_TAG_US, ...
AMAZON_PARTNER_TAG_DE=
AMAZON_PARTNER_TAG_US=
AMAZON_PARTNER_TAG_GB=

# ---- Overige winkels: affiliate-deeplink-templates per domein (Awin, Tradedoubler, Partnerize, Daisycon) ----
# {url_enc} = URL-encoded productlink, {url} = ruwe link
AFFILIATE_LINK_TEMPLATES={"coolblue.nl":"https://www.awin1.com/cread.php?awinmid=XXXX&awinaffid=YYYY&ued={url_enc}","mediamarkt.de":"https://www.awin1.com/cread.php?awinmid=XXXX&awinaffid=YYYY&ued={url_enc}"}

# ---- eBay Browse API + eBay Partner Network (alle eBay-sites) ----
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=

# ---- Vangnet voor elke overige webshop: Skimlinks of Sovrn Commerce maken van elke link een affiliate-link ----
# Skimlinks: https://go.skimresources.com/?id=PUBID&xs=1&url={url_enc}   Sovrn: https://redirect.viglink.com/?key=KEY&u={url_enc}
GENERIC_AFFILIATE_REDIRECT=

# ---- Social-automatisering ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHATS={"NL":"@pricedropalert_nl"}
# Metricool (Instellingen -> API): token + user id; blog id = merk-id in Metricool
METRICOOL_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
METRICOOL_NETWORKS=pinterest,instagram,tiktok
METRICOOL_PINTEREST_BOARD_ID=
METRICOOL_COUNTRIES=NL
METRICOOL_TIMEZONE=Europe/Amsterdam
NEXT_PUBLIC_CONTACT_EMAIL=
